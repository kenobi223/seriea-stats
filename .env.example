# Copia in .env e riempilo coi tuoi valori (il file .env NON va committato).
# Su Koyeb/Render queste stesse variabili si impostano nella dashboard del servizio.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# Il capo (chat_id del proprietario): ha tutto gratis. Vuoto = nessun privilegio.
TELEGRAM_OWNER_IDS=

# Codici voucher "completo a vita" (lista separata da virgole).
# SUBS_COUPONS=

# Prezzi abbonamento "completo" in Telegram Stars (oramai tutto gratis:
# serve solo se riattivi gli abbonamenti).
SUBS_WEEK_STARS=50
SUBS_MONTH_STARS=100

# Persistenza remota: su Koyeb/Render free l'istanza va sempre su Upstash
# (https://upstash.com). La URL va messa anche in REDIS_URL.
# REDIS_URL=redis://default:xxx@xxx.upstash.io:6379

# Self-heartbeat anti-sleep (Koyeb free spegne l'istanza dopo ~1h senza
# traffico). Metti l'URL pubblico del servizio.
# PUBLIC_URL=https://tuo-app.koyeb.app

# Intervallo refresh dati (secondi): default 600 (10 min). Su Koyeb free con
# 0.1 vCPU puoi alzarlo a 900 per non strozzare il ciclo.
# UPDATE_INTERVAL_SECONDS=900

# Koyeb/Render iniettano PORT automaticamente; locale usa 8765.
# PORT=8765